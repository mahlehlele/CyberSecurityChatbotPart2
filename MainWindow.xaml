<Window x:Class="CyberSecurityChatbotPart2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant - Part 2"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#0F172A">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#334155" />
        </Style>

        <Style x:Key="QuickTopicButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                CornerRadius="22"
                Padding="18"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Cybersecurity Awareness Assistant"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Part 2 WPF GUI with dynamic responses, memory, and sentiment detection"
                               Foreground="#CBD5E1"
                               Margin="0,8,0,14"
                               TextWrapping="Wrap" />

                    <Border Background="#020617" CornerRadius="16" Padding="10" Margin="0,0,0,14">
                        <Image Source="Assets/ascii-logo.png"
                               Height="185"
                               Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="Remember my name"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,6,0,6" />
                    <DockPanel LastChildFill="True">
                        <Button Content="Save"
                                DockPanel.Dock="Right"
                                Click="SaveNameButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <TextBox x:Name="NameTextBox"
                                 Margin="0,4,6,4"
                                 Padding="10"
                                 FontSize="14"
                                 ToolTip="Type your name, for example Asemahle" />
                    </DockPanel>

                    <TextBlock Text="Quick topics"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6" />
                    <WrapPanel>
                        <Button Content="Password" Tag="password" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Phishing" Tag="phishing" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Scams" Tag="scam" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Privacy" Tag="privacy" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Safe browsing" Tag="safe browsing" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Malware" Tag="malware" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Suspicious links" Tag="suspicious links" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="2FA" Tag="two-factor authentication" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Another tip" Tag="another tip" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                        <Button Content="Explain more" Tag="explain more" Click="QuickTopicButton_Click" Style="{StaticResource QuickTopicButtonStyle}" />
                    </WrapPanel>

                    <Border Background="#1E293B" CornerRadius="16" Padding="12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Memory status"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="MemoryTextBlock"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Content="Replay voice greeting"
                            Margin="0,16,0,0"
                            Click="PlayVoiceButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Copy transcript"
                            Click="CopyTranscriptButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Clear chat display"
                            Click="ClearChatButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E293B" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Chat with the bot"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="Press Enter or click Send. Try: 'I'm worried about online scams', 'I'm interested in privacy', or 'Give me another tip'."
                               Foreground="#CBD5E1"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#020617" CornerRadius="18" Padding="14" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MaxWidth="690" Margin="0,6" Padding="14" CornerRadius="16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Background" Value="#1E293B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Background" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding Sender}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding TimeText}"
                                                       Foreground="#E2E8F0"
                                                       FontSize="11"
                                                       Margin="12,0,0,0"
                                                       DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0"
                                                   FontSize="14.5" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Background="#1E293B" CornerRadius="18" Padding="14" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UserInputTextBox"
                             Grid.Column="0"
                             MinHeight="44"
                             MaxHeight="90"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="15"
                             Padding="12"
                             KeyDown="UserInputTextBox_KeyDown"
                             ToolTip="Type a cybersecurity question here" />

                    <Button Grid.Column="1"
                            Content="Send"
                            MinWidth="110"
                            Margin="10,0,0,0"
                            Click="SendButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
